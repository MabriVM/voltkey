# El iniciador automático reemplaza estos valores en .env en cada arranque.
# Para un servidor permanente, completa aquí tu dominio HTTPS/WSS.
EXPO_PUBLIC_WS_URL=wss://voltkey.tudominio.cl/ws
EXPO_PUBLIC_API_URL=https://voltkey.tudominio.cl
EXPO_PUBLIC_VOLTKEY_TOKEN=reemplaza-por-un-token-largo

# Variables del servidor Python (defínelas en PowerShell o en el servicio del servidor).
# VOLTKEY_SIMULATION=1 usa datos simulados; 0 acepta telemetry_input de un medidor externo.
VOLTKEY_SIMULATION=1
VOLTKEY_SEED_DEMO_HISTORY=1
VOLTKEY_TARIFF_CLP=280
VOLTKEY_TARIFF_AUTO_UPDATE=1
# VOLTKEY_TARIFF_SOURCE_URL=https://www.gruposaesa.cl/edelaysen/tarifas-vigentes
VOLTKEY_TIMEZONE=America/Santiago
VOLTKEY_ANOMALY_POWER_W=3500

# Arduino UNO R3 conectado por USB al computador.
VOLTKEY_ARDUINO_ENABLED=1
# Usa auto para detectar Arduino original y clones CH340/CP210x.
VOLTKEY_ARDUINO_PORT=auto
VOLTKEY_ARDUINO_BAUD=115200
# En esta edición el estado físico debe existir en el Arduino antes de aceptar órdenes.
VOLTKEY_ARDUINO_REQUIRED=1
VOLTKEY_CARD_DELAY_SECONDS=5
